# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# env files (secrets)
.env
.env*.local

# generated
/src/generated
next-env.d.ts

# uploaded media / local storage driver
/storage

# release builds
/release

# example env is documentation, keep it
!.env.example

# local logs
*.log

# end-to-end tests
/e2e/.logs
/test-results
/playwright-report

# Generated by next dev
/AGENTS.md

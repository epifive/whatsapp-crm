# CRM for WhatsApp — environment
# Docker: only POSTGRES_PASSWORD, APP_KEY and APP_URL (below) are needed; see docker-compose.yml.
# The web installer (/install) writes these for you. Everything else (SMTP, branding,
# payment gateways, WhatsApp/Meta app, AI providers) is configured in Admin > Settings.

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/wa_crm"

# 32 random bytes, base64. Signs sessions and encrypts stored secrets.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it logs everyone out and makes stored secrets unreadable.
APP_KEY=""

# Public URL of the app (used in emails and webhook URLs)
APP_URL="https://crm.example.com"

PORT=3000

# Optional: separate database for automated tests
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/wa_crm_test"

# Development only: let flow / workspace webhooks and media links reach localhost and private
# networks. Never enable on a public server (it disables SSRF protection).
# ALLOW_PRIVATE_NETWORK_REQUESTS=true

# Public demo server only. WARNING: the worker DELETES ALL workspaces and accounts every
# DEMO_RESET_HOURS and recreates the demo data. Set up with: npm run demo:reset
# DEMO_MODE=true
# DEMO_RESET_HOURS=3

# Optional: send AI requests through a proxy or an OpenAI-compatible gateway instead of the
# providers' default endpoints (the API key is still set in the admin panel / workspace settings).
# OPENAI_BASE_URL="https://api.openai.com"
# GEMINI_BASE_URL="https://generativelanguage.googleapis.com"
# ANTHROPIC_BASE_URL="https://api.anthropic.com"

# Optional: payment gateway API base URLs (proxies or test servers). Keys and webhook secrets
# are set in Admin > Settings > Billing.
# STRIPE_API_BASE="https://api.stripe.com"
# RAZORPAY_API_BASE="https://api.razorpay.com"
# PAYPAL_API_BASE="https://api-m.paypal.com"

# Docker Compose only: password for the bundled PostgreSQL, and the host port (default 3000)
# POSTGRES_PASSWORD="change-me"
# APP_PORT=3000
